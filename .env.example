# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devlens_ai?schema=public"

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="devlens-ai-secure-random-secret-key-32charsmin"

# Application URL
APP_URL="http://localhost:3000"

# AI Provider Configuration ("mock" | "gemini" | "openai")
AI_PROVIDER="mock"
AI_API_KEY="your-api-key-here"
AI_MODEL="gemini-1.5-pro"

# GitHub API Integration (Optional token for higher rate limits)
GITHUB_TOKEN=""
